{
  "name": "offlinet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/index.ts",
    "build:css": "bunx @tailwindcss/cli -i ./src/client/index.css -o ./dist/index.css --minify",
    "build:js": "bun build ./src/client/main.tsx --outdir ./dist --entry-naming [name].[ext] --minify",
    "build": "bun run build:css && bun run build:js && bun -e \"require('fs').copyFileSync('index.html', 'dist/index.html')\"",
    "server": "bun run src/server/index.ts",
    "start": "bun run src/server/index.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.2.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.7.3"
  }
}
